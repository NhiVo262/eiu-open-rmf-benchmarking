[Unit]
Description= TurtleBot3 bringup (OpenCR + LiDAR)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=HOME=/home/@USER@
ExecStart=/home/@USER@/turtlebot3_ws/autostart/run-bringup.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
