<?xml version='1.0' ?>
<launch>
  <arg name="server_uri" default="" description="The URI of the api server to transmit state and task information."/>
  <arg name="headless" default="false" description="Run Gazebo in headless mode"/>
  <arg name="use_sim_time" default="false" description="Use simulation time"/>

  <!-- RMF Common -->
  <include file="$(find-pkg-share tb3_fleet)/launch/rmf_common.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="config_file" value="$(find-pkg-share tb3_fleet)/maps/tb3_world/tb3_world.building.yaml"/>
    <arg name="server_uri" value="$(var server_uri)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="initial_map" value="tb3_world"/>
  </include>

  <!-- Gazebo World -->
  <set_env name="GZ_SIM_RESOURCE_PATH"
    value="$(find-pkg-share tb3_fleet)/maps/tb3_world/models:/usr/share/gz/gz-sim8" />

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args"
      value="$(find-pkg-share tb3_fleet)/maps/tb3_world/tb3_world.world -s -r" />
  </include>

  <group unless="$(var headless)">
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
      <arg name="gz_args" value="-g" />
    </include>
  </group>
</launch>