# Read by docker-compose.yaml when the stack is started without launch_docker.sh,
# which sets the value itself. Copy to .env and set the local GID:
#
#   getent group render
#
# GID of the host group owning /dev/dri/renderD*. Without a match the container user
# cannot reach the GPU and Gazebo renders every lidar on the CPU.
RENDER_GID=110
